NODE_ENV=development
PORT=4000

# Cadena pooled del rol micaja_api (Supabase, puerto 6543)
DATABASE_URL=
# Cadena directa para migraciones (puerto 5432)
DIRECT_URL=

JWT_SECRET=cambia-este-secreto-por-uno-de-64-caracteres-o-mas
JWT_EXPIRES_ADMIN=12h
JWT_EXPIRES_DEVICE=90d

# Clave privada Ed25519 en base64 (PKCS8). Generar con npm run keys:generate
LICENSE_PRIVATE_KEY=
LICENSE_KEY_ID=v1

CORS_ORIGINS=http://localhost:5173,http://localhost:8081
